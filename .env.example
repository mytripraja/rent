# ---- Client-side (Vite) — prefixed VITE_, safe to expose in the browser ----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional production abuse protection. Register rent.deepusiva.com in Firebase App Check
# using reCAPTCHA Enterprise, then place the public web site key here.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Optional OAuth account-linking entry points. Leave blank until the Google/Alexa
# authorization servers are actually implemented and registered.
VITE_GOOGLE_VOICE_LINK_URL=
VITE_ALEXA_LINK_URL=

# Cloudinary (file storage - replaces Firebase Storage)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# ---- Server-side only (Vercel serverless functions in /api) ----
# NEVER prefix these with VITE_ — that would expose them to the browser.
# Set these in Vercel Project Settings → Environment Variables, not just here.

# Firebase service account, as a single-line JSON string. Get it from
# Firebase Console → Project Settings → Service Accounts → Generate new private key.
# Paste the entire downloaded JSON file's contents as one line.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Set to true only after the App Check client is deployed and verified in production.
FIREBASE_APPCHECK_ENFORCED=false

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Random string (16+ chars) — shared secret so only your GitHub Actions
# workflow can trigger the vacate-access-revoke sweep.
REVOKE_CRON_SECRET=
# Google Cloud Storage bucket used by the daily server-side disaster backup job.
# The Firebase service account must have permission to write objects to this bucket.
BACKUP_BUCKET=

# Email OTP delivery for secure email-change requests
RESEND_API_KEY=
EMAIL_FROM=Rental Manager <no-reply@your-verified-domain.example>
