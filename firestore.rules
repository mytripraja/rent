rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isOwner() {
      return isSignedIn() && userDoc().data.role == 'owner';
    }

    function isTenant() {
      return isSignedIn() && userDoc().data.role == 'tenant';
    }

    function myHouseId() {
      return userDoc().data.houseId;
    }

    // ---- users ----
    // A user can read their own profile. Only the owner can create/edit user docs
    // (tenant accounts are created by the owner via createTenantAccount()).
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isOwner());
      allow write: if isOwner();
    }

    // ---- houses ----
    // Owner: full access. Tenant: can read their own house, and read a *limited*
    // public view of other houses is handled client-side (only expose safe fields
    // in the directory query — see note below) since Firestore rules can't do
    // per-field redaction on a single read.
    match /houses/{houseId} {
      allow read: if isOwner() || (isTenant() && myHouseId() == houseId);
      // Tenants may only self-update their own phone-visibility toggle — everything
      // else about a house (rent, advance, status, etc.) stays owner-only.
      allow update: if isOwner()
        || (isTenant() && myHouseId() == houseId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phoneVisibleToNeighbors']));
      allow create, delete: if isOwner();

      match /history/{entryId} {
        allow read, write: if isOwner();
      }
    }

    // ---- directory ----
    // Safe-fields-only mirror of houses (no rent/advance amounts) so tenants can
    // browse neighbors and vacant units without ever reading each other's house doc.
    match /directory/{houseId} {
      allow read: if isSignedIn();
      allow write: if isOwner() || (isTenant() && myHouseId() == houseId);
    }

    // ---- rentPayments ----
    // Tenant can create a submission for their own house, and read only their own house's payments.
    // Only the owner can approve/reject (update status).
    match /rentPayments/{paymentId} {
      allow read: if isOwner() || (isTenant() && resource.data.houseId == myHouseId());
      allow create: if isOwner() || (isTenant() && request.resource.data.houseId == myHouseId());
      allow update: if isOwner();
      allow delete: if isOwner();
    }

    // ---- ebBills / ebBillPayments ----
    match /ebBills/{billId} {
      allow read: if isOwner() || isTenant();
      allow write: if isOwner();
    }
    match /ebBillPayments/{paymentId} {
      allow read: if isOwner() || (isTenant() && resource.data.houseId == myHouseId());
      allow create: if isOwner() || (isTenant() && request.resource.data.houseId == myHouseId());
      allow update: if isOwner();
    }

    // ---- notices ----
    // Everyone signed in can read; only owner writes.
    match /notices/{noticeId} {
      allow read: if isSignedIn();
      allow write: if isOwner();
    }

    // ---- complaints ----
    // Tenant can create a complaint (from -> owner) and read: their own filed
    // complaints, plus owner -> house complaints addressed to their house (or 'all').
    // Owner can read/write everything.
    match /complaints/{complaintId} {
      allow read: if isOwner()
        || (isTenant() && resource.data.fromHouseId == myHouseId())
        || (isTenant() && resource.data.direction == 'owner_to_house'
            && (resource.data.targetHouseIds == 'all'
                || (resource.data.targetHouseIds is list && myHouseId() in resource.data.targetHouseIds)));
      allow create: if isOwner() || (isTenant() && request.resource.data.fromHouseId == myHouseId());
      allow update, delete: if isOwner();
    }

    // ---- community board ----
    match /communityMessages/{msgId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isOwner();
    }

    // ---- documents (Aadhaar / ration card, private) ----
    // Firestore metadata is separate from the actual file — the file itself sits
    // under private-documents/ in Storage, which requires the owner custom claim
    // to read (see storage.rules). This collection just tracks who uploaded what.
    match /documents/{docId} {
      allow read: if isOwner() || (isTenant() && resource.data.houseId == myHouseId());
      allow create: if isOwner() || (isTenant() && request.resource.data.houseId == myHouseId());
      allow update, delete: if isOwner();
    }
    match /vacateRecords/{recordId} {
      allow read, write: if isOwner();
    }

    // ---- serviceContacts ----
    match /serviceContacts/{contactId} {
      allow read: if isSignedIn();
      allow write: if isOwner();
    }

    // ---- customers (bank-style unique Customer ID per real person) ----
    // Full profile: owner can read/write anyone; a customer can read their own
    // record (matched via linkedUids, since one customer can hold several house logins).
    match /customers/{customerId} {
      allow read: if isOwner() || (isSignedIn() && request.auth.uid in resource.data.linkedUids);
      allow write: if isOwner();
    }

    // Minimal public lookup (customerId -> email only) so "login with Customer ID"
    // can resolve an email BEFORE the user is authenticated. No other field lives here.
    match /customerLookup/{customerId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // ---- counters (sequential Customer ID generator) ----
    // Tightened to owner-only: tenant creation now runs entirely through the
    // /api/create-tenant Admin SDK function (see lib/firebaseAdmin.js), which
    // bypasses these rules anyway, so client-side writes are never needed here.
    match /counters/{counterId} {
      allow read: if isOwner();
      allow write: if isOwner();
    }
  }
}
