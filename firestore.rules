rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn() && userDoc().data.role == 'admin';
    }

    // "Owner-level" access - the super-admin (Deepu) AND any co-owner (dad,
    // brother, mom, etc.) get the same day-to-day permissions. Only isAdmin()
    // is checked separately, for the one thing co-owners can't do: managing
    // other owner accounts.
    function isDadLite() {
      return isSignedIn() && userDoc().data.role == 'owner' && userDoc().data.appMode == 'dad-lite';
    }

    function isOwner() {
      return isSignedIn() && (userDoc().data.role == 'admin'
        || (userDoc().data.role == 'owner'
            && (!userDoc().data.keys().hasAny(['appMode']) || userDoc().data.appMode != 'dad-lite')));
    }

    function isTenant() {
      return isSignedIn() && userDoc().data.role == 'tenant';
    }

    // Server-enforced property workspace access. Missing propertyAccess keeps
    // legacy owner accounts working as all-properties admins; new restricted
    // accounts must contain '*' or the requested property id.
    function canAccessProperty(propertyId) {
      return isOwner() && (
        isAdmin()
        || !userDoc().data.keys().hasAny(['propertyAccess'])
        || userDoc().data.propertyAccess.hasAny(['*', propertyId])
      );
    }

    function canAccessPropertyRecord(data) {
      return isOwner() && (
        isAdmin()
        || !userDoc().data.keys().hasAny(['propertyAccess'])
        || (data.keys().hasAny(['propertyId']) && userDoc().data.propertyAccess.hasAny(['*', data.propertyId]))
      );
    }

    function recordPropertyId(data) {
      return data.keys().hasAny(['propertyId']) ? data.propertyId : 'default';
    }

    function canAccessHouse(houseId) {
      return isOwner() && houseId != null
        && exists(/databases/$(database)/documents/houses/$(houseId))
        && canAccessProperty(recordPropertyId(get(/databases/$(database)/documents/houses/$(houseId)).data));
    }

    // A tenant account is either the main household account (legacy tenant
    // profiles without accountType are treated as primary) or a controlled
    // family sub-account. Sub-accounts can be limited feature-by-feature by
    // the main tenant.
    function isPrimaryTenant() {
      return isTenant() && userDoc().data.accountType != 'sub';
    }

    function tenantCan(permission) {
      return isTenant() && (!userDoc().data.keys().hasAny(['tenantPermissions']) || !userDoc().data.tenantPermissions.keys().hasAny([permission]) || userDoc().data.tenantPermissions[permission] == true);
    }

    function myHouseId() {
      return userDoc().data.houseId;
    }

    // ---- email change requests ----
    // These contain verification metadata and are accessed only through the
    // server-side Admin SDK workflow. Never expose OTP hashes to the browser.
    match /emailChangeRequests/{requestId} {
      allow read, write: if false;
    }

    // ---- server audit logs ----
    match /auditLogs/{logId} {
      // Security/account audit records can contain target email/UID metadata.
      // Keep them in the admin security boundary rather than exposing the full
      // audit trail to restricted co-owners.
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---- users ----
    // Anyone can read their own profile; owner-level accounts can read anyone's.
    // A signed-in user can update their OWN name/phone/profile photo (self-service
    // profile editing) but never their own role or houseId. Creating or deleting
    // an owner-level account is admin-only — enforced both here and, more
    // importantly, in api/create-owner.js / api/delete-owner.js which actually
    // perform those actions via the Admin SDK (client-side create/delete of
    // another Firebase Auth user isn't possible anyway; this rule just protects
    // the Firestore doc from being spoofed independently of that).
    function canAccessUserRecord(data) {
      return isOwner() && (
        isAdmin()
        || !userDoc().data.keys().hasAny(['propertyAccess'])
        || (data.role == 'tenant'
            && data.houseId != null
            && canAccessHouse(data.houseId))
      );
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || canAccessUserRecord(resource.data));
      allow update: if isAdmin()
        || (isOwner() && resource.data.role == 'tenant'
            && request.resource.data.role == 'tenant'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tenantPermissions'])
            && (isAdmin() || (resource.data.houseId != null
                && exists(/databases/$(database)/documents/houses/$(resource.data.houseId))
                && canAccessProperty(recordPropertyId(get(/databases/$(database)/documents/houses/$(resource.data.houseId)).data)))))
        || (isSignedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'profilePhotoUrl', 'preferredLanguage']));
      allow create, delete: if isAdmin();
    }

    // ---- houses ----
    // Owner: full access. Tenant: can read their own house, and read a *limited*
    // public view of other houses is handled client-side (only expose safe fields
    // in the directory query — see note below) since Firestore rules can't do
    // per-field redaction on a single read.
    match /houses/{houseId} {
      // Owner reads/writes are property-scoped. The query path in houseService
      // always supplies propertyId so restricted co-owners cannot enumerate houses
      // outside their assigned apartments. Legacy records without propertyId are
      // treated as belonging to the default property.
      // Tenants do not read the full house document. It contains rent amounts,
      // advance information and owner-managed fields; tenant-safe house data is
      // returned through /api/tenant-rent-status instead.
      allow read: if isOwner() && canAccessProperty(recordPropertyId(resource.data));
      // Tenants may only self-update their own phone-visibility toggle — everything
      // else about a house (rent, advance, status, etc.) stays owner-only.
      allow update: if (isOwner() && canAccessProperty(recordPropertyId(resource.data)) && canAccessProperty(recordPropertyId(request.resource.data)))
        || (isTenant() && myHouseId() == houseId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phoneVisibleToNeighbors']));
      allow create: if isOwner() && canAccessProperty(recordPropertyId(request.resource.data));
      allow delete: if isOwner() && canAccessProperty(recordPropertyId(resource.data));

      match /assets/{assetId} {
        allow read: if isOwner() && canAccessProperty(recordPropertyId(get(/databases/$(database)/documents/houses/$(houseId)).data));
        allow write: if isOwner() && canAccessProperty(recordPropertyId(get(/databases/$(database)/documents/houses/$(houseId)).data));
      }
      match /inspections/{inspectionId} {
        allow read: if isOwner() && canAccessProperty(recordPropertyId(get(/databases/$(database)/documents/houses/$(houseId)).data));
        allow write: if isOwner() && canAccessProperty(recordPropertyId(get(/databases/$(database)/documents/houses/$(houseId)).data));
      }

      match /history/{entryId} {
        allow read, write: if isOwner() && canAccessProperty(recordPropertyId(get(/databases/$(database)/documents/houses/$(houseId)).data));
      }
    }

    // ---- directory ----
    // Safe-fields-only mirror of houses (no rent/advance amounts) so tenants can
    // browse neighbors and vacant units without ever reading each other's house doc.
    match /directory/{houseId} {
      allow read: if canAccessPropertyRecord(resource.data)
        || (tenantCan('directory')
            && resource.data.propertyId == recordPropertyId(get(/databases/$(database)/documents/houses/$(myHouseId())).data));
      allow write: if isOwner();
    }

    // ---- rentPayments ----
    // Tenant can create a submission for their own house, and read only their own house's payments.
    // Only the owner can approve/reject (update status).
    match /rentPayments/{paymentId} {
      allow read: if canAccessHouse(resource.data.houseId) || (tenantCan('rent') && tenantCan('rentDetails') && resource.data.houseId == myHouseId());
      allow create: if canAccessHouse(request.resource.data.houseId)
        || (tenantCan('rent') && tenantCan('rentSubmit')
            && request.resource.data.keys().hasOnly([
              'houseId', 'tenantId', 'month', 'amount', 'dateSent', 'mode',
              'cashReceivedBy', 'neighborHouseId', 'neighborCollectedBy',
              'proofUrl', 'proofPublicId', 'proofResourceType', 'applicationNumber',
              'status', 'uploadedByOwner', 'recordedBy', 'rejectionReason',
              'submittedAt', 'approvedAt', 'actionedBy'
            ])
            && request.resource.data.keys().hasAll([
              'houseId', 'tenantId', 'month', 'amount', 'dateSent', 'mode',
              'cashReceivedBy', 'neighborHouseId', 'neighborCollectedBy',
              'proofUrl', 'proofPublicId', 'proofResourceType', 'applicationNumber',
              'status', 'uploadedByOwner', 'recordedBy', 'rejectionReason',
              'submittedAt', 'approvedAt', 'actionedBy'
            ])
            && request.resource.data.houseId == myHouseId()
            && request.resource.data.tenantId == request.auth.uid
            && request.resource.data.month is string
            && request.resource.data.month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
            && request.resource.data.dateSent is string
            && request.resource.data.dateSent.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && request.resource.data.amount is number
            && request.resource.data.amount > 0
            && request.resource.data.amount <= 10000000
            && request.resource.data.mode in ['upi', 'bank', 'cash', 'neighbor']
            && (request.resource.data.mode != 'cash'
                || (request.resource.data.cashReceivedBy is string
                    && request.resource.data.cashReceivedBy.size() > 0
                    && request.resource.data.cashReceivedBy.size() <= 80))
            && (request.resource.data.mode == 'cash' || request.resource.data.cashReceivedBy == null)
            && (request.resource.data.mode != 'neighbor'
                || (request.resource.data.neighborHouseId is string
                    && request.resource.data.neighborHouseId.size() > 0
                    && request.resource.data.neighborHouseId.size() <= 120))
            && (request.resource.data.mode == 'neighbor' || request.resource.data.neighborHouseId == null)
            && request.resource.data.status == 'waiting_approval'
            && request.resource.data.uploadedByOwner == false
            && request.resource.data.approvedAt == null
            && request.resource.data.actionedBy == null
            && request.resource.data.rejectionReason == null
            && request.resource.data.recordedBy is map
            && request.resource.data.recordedBy.keys().hasOnly(['uid', 'name'])
            && request.resource.data.recordedBy.uid == request.auth.uid
            && request.resource.data.recordedBy.name is string
            && request.resource.data.recordedBy.name.size() <= 120
            && request.resource.data.submittedAt is number
            && request.resource.data.applicationNumber is string
            && request.resource.data.applicationNumber.size() > 0
            && request.resource.data.applicationNumber.size() <= 80
            && request.resource.data.proofUrl == null
            && (request.resource.data.proofPublicId == null || request.resource.data.proofPublicId is string)
            && (request.resource.data.proofResourceType == null || request.resource.data.proofResourceType in ['image', 'raw', 'video'])
            && request.resource.data.neighborCollectedBy == null);
      // Dad Lite can submit rent entries, but cannot approve/reject them.
      // This keeps the verification step with the admin account even if the
      // lite user reaches the Firestore API directly.
      allow update: if canAccessHouse(resource.data.houseId)
        && request.resource.data.houseId == resource.data.houseId
        && resource.data.status == 'waiting_approval'
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvedAt', 'actionedBy', 'neighborCollectedBy', 'rejectionReason']);
      allow delete: if canAccessHouse(resource.data.houseId);
    }

    // ---- physical EB meter reading register ----
    // Owners can record observations for houses they can access. Tenants can
    // read only the meter history belonging to their own house. The app queries
    // only by houseId, keeping the feature free from composite-index needs.
    match /ebMeterReadings/{readingId} {
      allow read: if canAccessHouse(resource.data.houseId)
        || (tenantCan('bills') && resource.data.houseId == myHouseId());
      allow create: if canAccessHouse(request.resource.data.houseId)
        && request.resource.data.reading >= 0
        && request.resource.data.readingDate is string
        && request.resource.data.readingDate.size() >= 8
        && request.resource.data.readingDate.size() <= 10
        && request.resource.data.propertyId == recordPropertyId(get(/databases/$(database)/documents/houses/$(request.resource.data.houseId)).data);
      allow update: if canAccessHouse(resource.data.houseId)
        && request.resource.data.houseId == resource.data.houseId
        && request.resource.data.propertyId == resource.data.propertyId;
      allow delete: if canAccessHouse(resource.data.houseId);
    }

    // ---- ebBills / ebBillPayments ----
    match /ebBills/{billId} {
      allow read: if canAccessPropertyRecord(resource.data) || (tenantCan('bills') && billId != null && resource.data.houseIds is list && myHouseId() in resource.data.houseIds);
      allow write: if canAccessPropertyRecord(request.resource.data);
    }
    match /ebBillPayments/{paymentId} {
      allow read: if canAccessHouse(resource.data.houseId) || (tenantCan('rent') && tenantCan('rentDetails') && resource.data.houseId == myHouseId());
      allow create: if canAccessHouse(request.resource.data.houseId)
        || (tenantCan('bills')
            && request.resource.data.houseId == myHouseId()
            && request.resource.data.tenantId == request.auth.uid
            && request.resource.data.status == 'waiting_approval'
            && request.resource.data.uploadedByOwner == false
            && request.resource.data.approvedAt == null
            && request.resource.data.actionedBy == null
            && request.resource.data.rejectionReason == null
            && request.resource.data.recordedBy.uid == request.auth.uid
            && request.resource.data.amount > 0);
      allow update: if canAccessHouse(resource.data.houseId)
        && request.resource.data.houseId == resource.data.houseId;
    }

    // ---- notices ----
    // Everyone signed in can read; only owner writes.
    match /notices/{noticeId} {
      allow read: if canAccessPropertyRecord(resource.data)
        || (tenantCan('notices')
            && (resource.data.targetHouseIds == 'all'
                || (resource.data.targetHouseIds is list && myHouseId() in resource.data.targetHouseIds)));
      allow create: if canAccessPropertyRecord(request.resource.data)
        && !request.resource.data.keys().hasAny(['linkedNoticeIds'])
        && (request.resource.data.parentNoticeId == null
            || (request.resource.data.parentNoticeId is string
                && exists(/databases/$(database)/documents/notices/$(request.resource.data.parentNoticeId))
                && get(/databases/$(database)/documents/notices/$(request.resource.data.parentNoticeId)).data.propertyId == request.resource.data.propertyId));
      allow update: if canAccessPropertyRecord(resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['linkedNoticeIds','linksUpdatedAt','linksUpdatedBy'])
        && request.resource.data.propertyId == resource.data.propertyId
        && (request.resource.data.parentNoticeId == null
            || (request.resource.data.parentNoticeId is string
                && exists(/databases/$(database)/documents/notices/$(request.resource.data.parentNoticeId))
                && get(/databases/$(database)/documents/notices/$(request.resource.data.parentNoticeId)).data.propertyId == resource.data.propertyId));
      allow delete: if canAccessPropertyRecord(resource.data);
    }

    // ---- complaints ----
    // Tenant can create a complaint (from -> owner) and read: their own filed
    // complaints, plus owner -> house complaints addressed to their house (or 'all').
    // Owner can read/write everything.
    match /complaints/{complaintId} {
      allow read: if canAccessPropertyRecord(resource.data)
        || (isOwner() && resource.data.fromHouseId != null
            && exists(/databases/$(database)/documents/houses/$(resource.data.fromHouseId))
            && canAccessProperty(recordPropertyId(get(/databases/$(database)/documents/houses/$(resource.data.fromHouseId)).data)))
        || (tenantCan('complaints') && resource.data.fromHouseId == myHouseId())
        || (tenantCan('complaints') && resource.data.direction == 'owner_to_house'
            && (resource.data.targetHouseIds == 'all'
                || (resource.data.targetHouseIds is list && myHouseId() in resource.data.targetHouseIds)));
      allow create: if canAccessPropertyRecord(request.resource.data)
        || (tenantCan('complaints') && request.resource.data.fromHouseId == myHouseId()
            && (!request.resource.data.keys().hasAny(['propertyId'])
                || request.resource.data.propertyId == recordPropertyId(get(/databases/$(database)/documents/houses/$(myHouseId())).data)));
      allow update: if (canAccessPropertyRecord(resource.data)
          || (isOwner() && resource.data.fromHouseId != null
              && exists(/databases/$(database)/documents/houses/$(resource.data.fromHouseId))
              && canAccessProperty(recordPropertyId(get(/databases/$(database)/documents/houses/$(resource.data.fromHouseId)).data))))
        && (!resource.data.keys().hasAny(['propertyId']) || request.resource.data.propertyId == resource.data.propertyId);
      allow delete: if canAccessPropertyRecord(resource.data)
        || (isOwner() && resource.data.fromHouseId != null
            && exists(/databases/$(database)/documents/houses/$(resource.data.fromHouseId))
            && canAccessProperty(recordPropertyId(get(/databases/$(database)/documents/houses/$(resource.data.fromHouseId)).data)));
    }

    // ---- notifications ----
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.recipientId == request.auth.uid;
      allow create: if isOwner()
        || (isTenant()
            && request.resource.data.recipientType == 'owner'
            && request.resource.data.recipientId != null
            && (get(/databases/$(database)/documents/users/$(request.resource.data.recipientId)).data.role == 'owner'
                || get(/databases/$(database)/documents/users/$(request.resource.data.recipientId)).data.role == 'admin'));
      allow update: if isSignedIn() && resource.data.recipientId == request.auth.uid;
      allow delete: if isOwner();
    }

    // ---- community board ----
    match /communityMessages/{msgId} {
      allow read: if isOwner() || tenantCan('community');
      allow create: if isSignedIn()
        && (isOwner() || tenantCan('community'))
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.createdAt is int
        && (isOwner()
            || (request.resource.data.authorRole == 'tenant'
                && request.resource.data.houseId == myHouseId()));
      allow update, delete: if isOwner();
    }

    // ---- documents (Aadhaar / ration card, private) ----
    // Firestore metadata is separate from the actual file — the file itself is a
    // private Cloudinary asset (type: 'authenticated'), viewable only via a
    // freshly-signed URL that api/get-signed-url.js mints for owner-level accounts.
    // This collection just tracks who uploaded what.
    match /documents/{docId} {
      allow read: if canAccessHouse(resource.data.houseId)
        || (tenantCan('documents')
            && resource.data.houseId == myHouseId()
            && resource.data.tenantId == request.auth.uid);
      allow create: if (
          request.resource.data.docType in ['aadhaar', 'ration_card']
          && request.resource.data.houseId is string
          && request.resource.data.tenantId is string
          && request.resource.data.residentName is string
          && request.resource.data.publicId is string
          && request.resource.data.resourceType is string
          && request.resource.data.consentSignatureName is string
          && request.resource.data.consentAcceptedAt is int
          && request.resource.data.uploadedAt is int
          && (canAccessHouse(request.resource.data.houseId)
            || (tenantCan('documents')
                && request.resource.data.houseId == myHouseId()
                && request.resource.data.tenantId == request.auth.uid))
        );
      allow update: if canAccessHouse(resource.data.houseId)
        && request.resource.data.houseId == resource.data.houseId
        && request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if canAccessHouse(resource.data.houseId);
    }
    match /vacateRecords/{recordId} {
      allow read, write: if isOwner();
    }

    // ---- serviceContacts ----
    match /serviceContacts/{contactId} {
      allow read: if isOwner() || tenantCan('serviceContacts');
      allow write: if isOwner();
    }

    // ---- appConfig ----
    match /appConfig/{configId} {
      // Clients use /api/app-config so the Admin SDK can apply role/property
      // filtering. Direct reads/writes are admin-only to prevent a restricted
      // owner from changing the global configuration through the SDK.
      allow read, write: if isAdmin();
    }

    // Reminder schedules are management data. Direct client reads/writes are
    // disabled; the owner settings UI uses the authenticated server endpoint so
    // restricted owners cannot enumerate or overwrite another property's rules.
    match /rentReminderRules/{ruleId} {
      allow read, write: if isAdmin();
    }

    // ---- customers (bank-style unique Customer ID per real person) ----
    // Full profile: owner can read/write anyone; a customer can read their own
    // record (matched via linkedUids, since one customer can hold several house logins).
    match /customers/{customerId} {
      // Customer records may contain Aadhaar numbers and linked-house history.
      // Residents do not need the raw customer document; expose only the safe
      // customer ID through users/{uid} and keep the full record owner-only.
      allow read, write: if isOwner();
    }

    // Minimal public lookup (customerId -> email only) so "login with Customer ID"
    // can resolve an email BEFORE the user is authenticated. No other field lives here.
    match /customerLookup/{customerId} {
      // The browser must not be able to enumerate customer IDs -> emails.
      // Customer-ID login uses /api/resolve-customer-id instead.
      allow read: if false;
      allow write: if isOwner();
    }

    // ---- counters (sequential Customer ID generator) ----
    // Tightened to owner-only: tenant creation now runs entirely through the
    // /api/create-tenant Admin SDK function (see lib/firebaseAdmin.js), which
    // bypasses these rules anyway, so client-side writes are never needed here.
    match /counters/{counterId} {
      allow read: if isOwner();
      allow write: if isOwner();
    }

    // ---- advanceLedger (partial advance payments over time) ----
    match /advanceLedger/{entryId} {
      allow read: if canAccessHouse(resource.data.houseId) || (tenantCan('rent') && tenantCan('rentDetails') && resource.data.houseId == myHouseId());
      allow create: if canAccessHouse(request.resource.data.houseId);
      allow update: if canAccessHouse(resource.data.houseId)
        && request.resource.data.houseId == resource.data.houseId;
      allow delete: if canAccessHouse(resource.data.houseId);
    }

    // ---- expenses ----
    match /expenses/{expenseId} {
      allow read, write: if isOwner();
    }

    // ---- waterBills / waterBillPayments ----
    match /waterBills/{billId} {
      allow read: if canAccessPropertyRecord(resource.data) || (tenantCan('bills') && resource.data.houseIds is list && myHouseId() in resource.data.houseIds);
      allow write: if canAccessPropertyRecord(request.resource.data);
    }
    match /waterBillPayments/{paymentId} {
      allow read: if canAccessHouse(resource.data.houseId) || (tenantCan('rent') && tenantCan('rentDetails') && resource.data.houseId == myHouseId());
      allow create: if canAccessHouse(request.resource.data.houseId)
        || (tenantCan('bills')
            && request.resource.data.houseId == myHouseId()
            && request.resource.data.tenantId == request.auth.uid
            && request.resource.data.status == 'waiting_approval'
            && request.resource.data.uploadedByOwner == false
            && request.resource.data.approvedAt == null
            && request.resource.data.actionedBy == null
            && request.resource.data.rejectionReason == null
            && request.resource.data.recordedBy.uid == request.auth.uid
            && request.resource.data.amount > 0);
      allow update: if canAccessHouse(resource.data.houseId)
        && request.resource.data.houseId == resource.data.houseId;
    }

    // ---- maintenanceRequests ----
    match /maintenanceRequests/{requestId} {
      allow read: if canAccessHouse(resource.data.houseId) || (tenantCan('maintenance') && resource.data.houseId == myHouseId());
      allow create: if canAccessHouse(request.resource.data.houseId) || (tenantCan('maintenance') && request.resource.data.houseId == myHouseId());
      allow update: if canAccessHouse(resource.data.houseId)
        && request.resource.data.houseId == resource.data.houseId;
      allow delete: if canAccessHouse(resource.data.houseId);
    }

    // ---- visitors ----
    match /visitors/{visitorId} {
      allow read: if canAccessHouse(resource.data.houseId) || (tenantCan('visitors') && resource.data.houseId == myHouseId());
      allow create: if canAccessHouse(request.resource.data.houseId) || (tenantCan('visitors') && request.resource.data.houseId == myHouseId());
      allow update: if (canAccessHouse(resource.data.houseId) && request.resource.data.houseId == resource.data.houseId)
        || (tenantCan('visitors') && resource.data.houseId == myHouseId() && request.resource.data.houseId == resource.data.houseId);
      allow delete: if canAccessHouse(resource.data.houseId);
    }

    // ---- rentAgreements ----
    match /rentAgreements/{agreementId} {
      allow read: if canAccessHouse(resource.data.houseId) || (tenantCan('rent') && tenantCan('rentDetails') && resource.data.houseId == myHouseId());
      allow create: if canAccessHouse(request.resource.data.houseId);
      allow update: if canAccessHouse(resource.data.houseId)
        && request.resource.data.houseId == resource.data.houseId;
      allow delete: if canAccessHouse(resource.data.houseId);
    }

    // ---- community Wi-Fi sharing ----
    // Listings intentionally expose only sharing details. Never store or expose a Wi-Fi password here.
    match /wifiShares/{listingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && (isOwner() || request.resource.data.houseId == myHouseId())
        && request.resource.data.status == 'active'
        && request.resource.data.monthlyShare >= 0
        && request.resource.data.maxMembers >= 1
        && (request.resource.data.termsVersion == 'wifi-share-v1' || request.resource.data.termsVersion == 'wifi-share-v2' || request.resource.data.termsVersion == 'wifi-share-v3')
        && request.resource.data.termsAcceptedAt is int
        && request.resource.data.termsAcceptedBy == request.auth.uid
        && request.resource.data.ispAuthorized == true
        && (request.resource.data.termsVersion == 'wifi-share-v1' || request.resource.data.lawfulUseAccepted == true);
      allow update: if isSignedIn() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.houseId == resource.data.houseId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','speedMbps','monthlyShare','maxMembers','providerPhone','notes','updatedAt']);
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }
    match /wifiShareInterests/{interestId} {
      allow read: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || resource.data.seekerUid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.seekerUid == request.auth.uid
        && request.resource.data.ownerUid != request.auth.uid
        && exists(/databases/$(database)/documents/wifiShares/$(request.resource.data.listingId))
        && get(/databases/$(database)/documents/wifiShares/$(request.resource.data.listingId)).data.status == 'active'
        && get(/databases/$(database)/documents/wifiShares/$(request.resource.data.listingId)).data.ownerUid == request.resource.data.ownerUid
        && get(/databases/$(database)/documents/wifiShares/$(request.resource.data.listingId)).data.houseId == request.resource.data.houseId;
      allow update: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || resource.data.seekerUid == request.auth.uid);
    }

    // ---- personal calendar notes ----
    match /calendarNotes/{noteId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ---- events ----
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow write: if isOwner();
    }

    // ---- parkingSlots ----
    // Vehicle numbers and house assignments are private property-management data.
    match /parkingSlots/{slotId} {
      allow read: if isOwner() && canAccessProperty(recordPropertyId(resource.data));
      allow create: if isOwner() && canAccessProperty(recordPropertyId(request.resource.data));
      allow update: if isOwner() && canAccessProperty(recordPropertyId(resource.data)) && canAccessProperty(recordPropertyId(request.resource.data));
      allow delete: if isOwner() && canAccessProperty(recordPropertyId(resource.data));
    }


    // ---- internal logs / reminder markers ----
    match /activityLog/{entryId} {
      // Activity entries can contain tenant/house action details. New entries
      // carry propertyId so restricted co-owners only see their assigned
      // apartment activity. Legacy entries without propertyId remain visible
      // to admin/unrestricted owners through canAccessPropertyRecord().
      allow read: if canAccessPropertyRecord(resource.data);
      allow create: if canAccessPropertyRecord(request.resource.data);
      allow update: if canAccessPropertyRecord(resource.data)
        && request.resource.data.propertyId == resource.data.propertyId;
      allow delete: if canAccessPropertyRecord(resource.data);
    }
    match /communicationLogs/{entryId} {
      allow read, write: if isOwner();
    }
    match /remindersSent/{entryId} {
      allow read, write: if isOwner();
    }

    // ---- blueprints ----
    // Owners can create and edit visual plans. A tenant can only read the plan for
    // their own house when the owner explicitly enables resident visibility.
    match /houseBlueprints/{houseId} {
      allow read: if canAccessHouse(houseId)
        || (tenantCan('blueprint') && myHouseId() == houseId && resource.data.visibleToTenants == true);
      allow write: if isOwner();
    }
    match /propertyBlueprints/{blueprintId} {
      allow read: if isOwner()
        || (tenantCan('blueprint') && resource.data.visibleToTenants == true
            && (!resource.data.keys().hasAny(['propertyId'])
                || resource.data.propertyId == recordPropertyId(get(/databases/$(database)/documents/houses/$(myHouseId())).data)));
      allow write: if isOwner();
    }

    // ---- multi-apartment operations ----
    // Operational records are owner-only and always carry a propertyId so one
    // apartment's motors, tanks, problem history and CCTV records are not mixed
    // with another apartment in the management UI.
    match /apartmentOperations/{propertyId} {
      allow read, write: if canAccessProperty(propertyId);
    }
    match /motorCommands/{commandId} {
      allow read: if canAccessProperty(recordPropertyId(resource.data));
      allow create: if canAccessProperty(recordPropertyId(request.resource.data));
      allow update: if canAccessProperty(recordPropertyId(request.resource.data));
      allow delete: if canAccessProperty(recordPropertyId(resource.data));
    }
    match /propertyIssues/{issueId} {
      allow read: if canAccessProperty(recordPropertyId(resource.data));
      allow create: if canAccessProperty(recordPropertyId(request.resource.data));
      allow update: if canAccessProperty(recordPropertyId(request.resource.data));
      allow delete: if canAccessProperty(recordPropertyId(resource.data));
    }
    match /cctvCameras/{cameraId} {
      allow read: if canAccessProperty(recordPropertyId(resource.data));
      allow create: if canAccessProperty(recordPropertyId(request.resource.data))
        && (request.resource.data.privacyPolicyVersion == 'cctv-privacy-v1' || request.resource.data.privacyPolicyVersion == 'cctv-privacy-v2')
        && request.resource.data.privacyAcknowledgedAt is int
        && request.resource.data.retentionDays is int
        && request.resource.data.retentionDays >= 1
        && request.resource.data.retentionDays <= 3650;
      allow update: if canAccessProperty(recordPropertyId(resource.data))
        && canAccessProperty(recordPropertyId(request.resource.data))
        && recordPropertyId(resource.data) == recordPropertyId(request.resource.data)
        && (request.resource.data.privacyPolicyVersion == 'cctv-privacy-v1' || request.resource.data.privacyPolicyVersion == 'cctv-privacy-v2')
        && request.resource.data.privacyAcknowledgedAt is int
        && request.resource.data.retentionDays is int
        && request.resource.data.retentionDays >= 1
        && request.resource.data.retentionDays <= 3650;
      allow delete: if canAccessProperty(recordPropertyId(resource.data));
    }
    match /cctvFootageRequests/{requestId} {
      allow read: if canAccessProperty(recordPropertyId(resource.data));
      allow create: if canAccessProperty(recordPropertyId(request.resource.data));
      allow update: if canAccessProperty(recordPropertyId(request.resource.data));
      allow delete: if canAccessProperty(recordPropertyId(resource.data));
    }

    // ---- advanced operations ERP ----
    // Every new operational record is property-scoped and access is enforced here,
    // not only by the React apartment selector.
    match /accountingTransactions/{id} {
      allow read: if canAccessProperty(recordPropertyId(resource.data));
      allow create: if canAccessProperty(recordPropertyId(request.resource.data));
      allow update: if canAccessProperty(recordPropertyId(request.resource.data)) && recordPropertyId(resource.data) == recordPropertyId(request.resource.data)
        && (request.resource.data.privacyPolicyVersion == 'cctv-privacy-v1' || request.resource.data.privacyPolicyVersion == 'cctv-privacy-v2')
        && request.resource.data.privacyAcknowledgedAt is int
        && request.resource.data.retentionDays is int
        && request.resource.data.retentionDays >= 1
        && request.resource.data.retentionDays <= 3650;
      allow delete: if canAccessProperty(recordPropertyId(resource.data));
    }
    match /maintenanceWorkOrders/{id} {
      allow read: if canAccessProperty(recordPropertyId(resource.data));
      allow create: if canAccessProperty(recordPropertyId(request.resource.data));
      allow update: if canAccessProperty(recordPropertyId(request.resource.data)) && recordPropertyId(resource.data) == recordPropertyId(request.resource.data)
        && (request.resource.data.privacyPolicyVersion == 'cctv-privacy-v1' || request.resource.data.privacyPolicyVersion == 'cctv-privacy-v2')
        && request.resource.data.privacyAcknowledgedAt is int
        && request.resource.data.retentionDays is int
        && request.resource.data.retentionDays >= 1
        && request.resource.data.retentionDays <= 3650;
      allow delete: if canAccessProperty(recordPropertyId(resource.data));
    }
    match /preventiveMaintenance/{id} {
      allow read: if canAccessProperty(recordPropertyId(resource.data));
      allow create: if canAccessProperty(recordPropertyId(request.resource.data));
      allow update: if canAccessProperty(recordPropertyId(request.resource.data)) && recordPropertyId(resource.data) == recordPropertyId(request.resource.data)
        && (request.resource.data.privacyPolicyVersion == 'cctv-privacy-v1' || request.resource.data.privacyPolicyVersion == 'cctv-privacy-v2')
        && request.resource.data.privacyAcknowledgedAt is int
        && request.resource.data.retentionDays is int
        && request.resource.data.retentionDays >= 1
        && request.resource.data.retentionDays <= 3650;
      allow delete: if canAccessProperty(recordPropertyId(resource.data));
    }
    match /purchaseOrders/{id} {
      allow read: if canAccessProperty(recordPropertyId(resource.data));
      allow create: if canAccessProperty(recordPropertyId(request.resource.data));
      allow update: if canAccessProperty(recordPropertyId(request.resource.data)) && recordPropertyId(resource.data) == recordPropertyId(request.resource.data)
        && (request.resource.data.privacyPolicyVersion == 'cctv-privacy-v1' || request.resource.data.privacyPolicyVersion == 'cctv-privacy-v2')
        && request.resource.data.privacyAcknowledgedAt is int
        && request.resource.data.retentionDays is int
        && request.resource.data.retentionDays >= 1
        && request.resource.data.retentionDays <= 3650;
      allow delete: if canAccessProperty(recordPropertyId(resource.data));
    }
    match /inventoryItems/{id} {
      allow read: if canAccessProperty(recordPropertyId(resource.data));
      allow create: if canAccessProperty(recordPropertyId(request.resource.data));
      allow update: if canAccessProperty(recordPropertyId(request.resource.data)) && recordPropertyId(resource.data) == recordPropertyId(request.resource.data)
        && (request.resource.data.privacyPolicyVersion == 'cctv-privacy-v1' || request.resource.data.privacyPolicyVersion == 'cctv-privacy-v2')
        && request.resource.data.privacyAcknowledgedAt is int
        && request.resource.data.retentionDays is int
        && request.resource.data.retentionDays >= 1
        && request.resource.data.retentionDays <= 3650;
      allow delete: if canAccessProperty(recordPropertyId(resource.data));
    }
    match /securityEvents/{id} {
      allow read: if canAccessProperty(recordPropertyId(resource.data));
      allow create: if canAccessProperty(recordPropertyId(request.resource.data));
      allow update: if canAccessProperty(recordPropertyId(request.resource.data)) && recordPropertyId(resource.data) == recordPropertyId(request.resource.data)
        && (request.resource.data.privacyPolicyVersion == 'cctv-privacy-v1' || request.resource.data.privacyPolicyVersion == 'cctv-privacy-v2')
        && request.resource.data.privacyAcknowledgedAt is int
        && request.resource.data.retentionDays is int
        && request.resource.data.retentionDays >= 1
        && request.resource.data.retentionDays <= 3650;
      allow delete: if canAccessProperty(recordPropertyId(resource.data));
    }
    match /parcels/{id} {
      allow read: if canAccessProperty(recordPropertyId(resource.data));
      allow create: if canAccessProperty(recordPropertyId(request.resource.data));
      allow update: if canAccessProperty(recordPropertyId(request.resource.data)) && recordPropertyId(resource.data) == recordPropertyId(request.resource.data)
        && (request.resource.data.privacyPolicyVersion == 'cctv-privacy-v1' || request.resource.data.privacyPolicyVersion == 'cctv-privacy-v2')
        && request.resource.data.privacyAcknowledgedAt is int
        && request.resource.data.retentionDays is int
        && request.resource.data.retentionDays >= 1
        && request.resource.data.retentionDays <= 3650;
      allow delete: if canAccessProperty(recordPropertyId(resource.data));
    }
    match /leaseRecords/{id} {
      allow read: if canAccessProperty(recordPropertyId(resource.data));
      allow create: if canAccessProperty(recordPropertyId(request.resource.data));
      allow update: if canAccessProperty(recordPropertyId(request.resource.data)) && recordPropertyId(resource.data) == recordPropertyId(request.resource.data)
        && (request.resource.data.privacyPolicyVersion == 'cctv-privacy-v1' || request.resource.data.privacyPolicyVersion == 'cctv-privacy-v2')
        && request.resource.data.privacyAcknowledgedAt is int
        && request.resource.data.retentionDays is int
        && request.resource.data.retentionDays >= 1
        && request.resource.data.retentionDays <= 3650;
      allow delete: if canAccessProperty(recordPropertyId(resource.data));
    }
    match /utilityBills/{id} {
      allow read: if canAccessProperty(recordPropertyId(resource.data));
      allow create: if canAccessProperty(recordPropertyId(request.resource.data));
      allow update: if canAccessProperty(recordPropertyId(request.resource.data)) && recordPropertyId(resource.data) == recordPropertyId(request.resource.data)
        && (request.resource.data.privacyPolicyVersion == 'cctv-privacy-v1' || request.resource.data.privacyPolicyVersion == 'cctv-privacy-v2')
        && request.resource.data.privacyAcknowledgedAt is int
        && request.resource.data.retentionDays is int
        && request.resource.data.retentionDays >= 1
        && request.resource.data.retentionDays <= 3650;
      allow delete: if canAccessProperty(recordPropertyId(resource.data));
    }
    match /ownerInvestments/{id} {
      allow read: if canAccessProperty(recordPropertyId(resource.data));
      allow create: if canAccessProperty(recordPropertyId(request.resource.data));
      allow update: if canAccessProperty(recordPropertyId(request.resource.data)) && recordPropertyId(resource.data) == recordPropertyId(request.resource.data)
        && (request.resource.data.privacyPolicyVersion == 'cctv-privacy-v1' || request.resource.data.privacyPolicyVersion == 'cctv-privacy-v2')
        && request.resource.data.privacyAcknowledgedAt is int
        && request.resource.data.retentionDays is int
        && request.resource.data.retentionDays >= 1
        && request.resource.data.retentionDays <= 3650;
      allow delete: if canAccessProperty(recordPropertyId(resource.data));
    }
    match /communicationMessages/{id} {
      allow read: if canAccessProperty(recordPropertyId(resource.data));
      allow create: if canAccessProperty(recordPropertyId(request.resource.data));
      allow update: if canAccessProperty(recordPropertyId(request.resource.data)) && recordPropertyId(resource.data) == recordPropertyId(request.resource.data)
        && (request.resource.data.privacyPolicyVersion == 'cctv-privacy-v1' || request.resource.data.privacyPolicyVersion == 'cctv-privacy-v2')
        && request.resource.data.privacyAcknowledgedAt is int
        && request.resource.data.retentionDays is int
        && request.resource.data.retentionDays >= 1
        && request.resource.data.retentionDays <= 3650;
      allow delete: if canAccessProperty(recordPropertyId(resource.data));
    }
    match /societyHierarchy/{id} {
      allow read: if canAccessProperty(recordPropertyId(resource.data));
      allow create: if canAccessProperty(recordPropertyId(request.resource.data));
      allow update: if canAccessProperty(recordPropertyId(request.resource.data)) && recordPropertyId(resource.data) == recordPropertyId(request.resource.data)
        && (request.resource.data.privacyPolicyVersion == 'cctv-privacy-v1' || request.resource.data.privacyPolicyVersion == 'cctv-privacy-v2')
        && request.resource.data.privacyAcknowledgedAt is int
        && request.resource.data.retentionDays is int
        && request.resource.data.retentionDays >= 1
        && request.resource.data.retentionDays <= 3650;
      allow delete: if canAccessProperty(recordPropertyId(resource.data));
    }
    match /documentRegistry/{id} {
      allow read: if canAccessProperty(recordPropertyId(resource.data));
      allow create: if canAccessProperty(recordPropertyId(request.resource.data));
      allow update: if canAccessProperty(recordPropertyId(request.resource.data)) && recordPropertyId(resource.data) == recordPropertyId(request.resource.data)
        && (request.resource.data.privacyPolicyVersion == 'cctv-privacy-v1' || request.resource.data.privacyPolicyVersion == 'cctv-privacy-v2')
        && request.resource.data.privacyAcknowledgedAt is int
        && request.resource.data.retentionDays is int
        && request.resource.data.retentionDays >= 1
        && request.resource.data.retentionDays <= 3650;
      allow delete: if canAccessProperty(recordPropertyId(resource.data));
    }
    match /backupPlans/{id} {
      allow read: if canAccessProperty(recordPropertyId(resource.data));
      allow create: if canAccessProperty(recordPropertyId(request.resource.data));
      allow update: if canAccessProperty(recordPropertyId(request.resource.data)) && recordPropertyId(resource.data) == recordPropertyId(request.resource.data)
        && (request.resource.data.privacyPolicyVersion == 'cctv-privacy-v1' || request.resource.data.privacyPolicyVersion == 'cctv-privacy-v2')
        && request.resource.data.privacyAcknowledgedAt is int
        && request.resource.data.retentionDays is int
        && request.resource.data.retentionDays >= 1
        && request.resource.data.retentionDays <= 3650;
      allow delete: if canAccessProperty(recordPropertyId(resource.data));
    }
    match /apiIntegrations/{id} {
      allow read: if canAccessProperty(recordPropertyId(resource.data));
      allow create: if canAccessProperty(recordPropertyId(request.resource.data));
      allow update: if canAccessProperty(recordPropertyId(request.resource.data)) && recordPropertyId(resource.data) == recordPropertyId(request.resource.data)
        && (request.resource.data.privacyPolicyVersion == 'cctv-privacy-v1' || request.resource.data.privacyPolicyVersion == 'cctv-privacy-v2')
        && request.resource.data.privacyAcknowledgedAt is int
        && request.resource.data.retentionDays is int
        && request.resource.data.retentionDays >= 1
        && request.resource.data.retentionDays <= 3650;
      allow delete: if canAccessProperty(recordPropertyId(resource.data));
    }

    // ---- areaBookings ----
    match /areaBookings/{bookingId} {
      allow read: if canAccessHouse(resource.data.houseId) || (tenantCan('commonArea') && resource.data.houseId == myHouseId());
      allow create: if canAccessHouse(request.resource.data.houseId) || (tenantCan('commonArea')
        && request.resource.data.houseId == myHouseId()
        && request.resource.data.tenantId == request.auth.uid
        && request.resource.data.status == 'pending');
      allow update: if canAccessHouse(resource.data.houseId)
        && request.resource.data.houseId == resource.data.houseId;
      allow delete: if canAccessHouse(resource.data.houseId);
    }
  }
}

